{
  "openapi": "3.0.0",
  "info": {
    "title": "Contact Management API",
    "version": "1.0.0",
    "description": "REST API for managing enterprise contacts."
  },
  "servers": [
    {
      "url": "http://localhost:5000/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/contacts": {
      "get": {
        "summary": "Get all contacts",
        "description": "Retrieves a paginated, filtered, and sorted list of contacts.",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": { "type": "integer" },
            "description": "Page number"
          },
          {
            "in": "query",
            "name": "limit",
            "schema": { "type": "integer" },
            "description": "Items per page"
          },
          {
            "in": "query",
            "name": "status",
            "schema": { "type": "string" },
            "description": "Filter by status (Active/Inactive)"
          },
          {
            "in": "query",
            "name": "search",
            "schema": { "type": "string" },
            "description": "Search by name or email"
          },
          {
            "in": "query",
            "name": "sortBy",
            "schema": { "type": "string" },
            "description": "Field to sort by"
          },
          {
            "in": "query",
            "name": "sortOrder",
            "schema": { "type": "string" },
            "description": "Order (asc/desc)"
          }
        ],
        "responses": {
          "200": { "description": "Successful response" }
        }
      },
      "post": {
        "summary": "Create a new contact",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "first_name": { "type": "string" },
                  "last_name": { "type": "string" },
                  "email": { "type": "string" },
                  "phone_number": { "type": "string" },
                  "company_name": { "type": "string" },
                  "status": { "type": "string", "enum": ["Active", "Inactive"] }
                },
                "required": ["first_name", "email"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Contact created" },
          "400": { "description": "Validation error" }
        }
      }
    },
    "/contacts/{id}": {
      "put": {
        "summary": "Update an existing contact",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "first_name": { "type": "string" },
                  "status": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Contact updated" }
        }
      },
      "delete": {
        "summary": "Soft delete a contact",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Contact deleted successfully" }
        }
      }
    }
  }
}
